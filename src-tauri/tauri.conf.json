{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MD Reader",
  "version": "0.1.0",
  "identifier": "com.mdreader.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MD Reader",
        "width": 1120,
        "height": 780,
        "minWidth": 560,
        "minHeight": 420,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset: http://asset.localhost https:; style-src 'self' 'unsafe-inline'; script-src 'self'",
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "targets": ["nsis", "dmg", "appimage", "deb"],
    "category": "Utility",
    "publisher": "MD Reader contributors",
    "homepage": "https://github.com/SpNkd/md-reader",
    "copyright": "Copyright © 2026 MD Reader contributors",
    "license": "MIT",
    "shortDescription": "A fast, focused Markdown reader",
    "longDescription": "Open Markdown quickly, read it comfortably, and edit it when needed.",
    "fileAssociations": [
      {
        "ext": ["md", "markdown"],
        "mimeType": "text/markdown",
        "description": "Markdown document",
        "role": "Viewer"
      }
    ]
  }
}
